# SOPS Secrets Template
# 1. Copy to secrets.yaml.work
# 2. Fill in your values
# 3. Run ./encrypt

# Generate with: mkpasswd -m SHA-512
user_hashedPassword: "$6$..."

# Tailscale auth key (from https://login.tailscale.com/admin/settings/keys)
tailscale_authKey: "tskey-auth-..."

# WiFi PSK (only needed if enableWifi = true in settings.nix)
# wifi_psk: "your_wifi_password"

# OpenClaw gateway token
openclaw_gateway_token: "tok_..."
openclaw_gateway_password: "your_gateway_password"

# OpenRouter API key (for OpenClaw)
openrouter_api_key: "sk-or-..."

# Anthropic API key (for OpenClaw direct access)
anthropic_api_key: "sk-ant-..."

# Brave Search API key (for OpenClaw web search)
brave_search_api_key: "BSA..."

# Telegram bot token (for OpenClaw channels)
telegram_bot_token: '123456:ABC...'

# Telegram admin user ID (for OpenClaw elevated tool access)
telegram_admin_id: '123456789'

# Composio self-hosted secrets
composio_encryption_key: "your_encryption_key"
composio_jwt_secret: "your_jwt_secret"

# Google Workspace MCP (OAuth client credentials for OpenClaw)
google_workspace_client_id: "261437751113-....apps.googleusercontent.com"
google_workspace_client_secret: "GOCSPX-..."
google_places_api_key: "AIzaSy..."

# OneDrive rclone config (full rclone config file content)
onedrive_rclone_config: |
  [onedrive]
  type = onedrive
  token = {"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}
  drive_id = ...
  drive_type = personal

# Cloudflared tunnel credentials JSON
# Prefer: ./scripts/setup-cloudflare-tunnel.sh (needs Account.Cloudflare Tunnel:Edit on the API token)
# Manual: cloudflared tunnel create rocknas → paste ~/.cloudflared/<uuid>.json
cloudflared_tunnel_credentials: |
  {"AccountTag":"...","TunnelID":"...","TunnelSecret":"..."}

# Browserless.io API key (for OpenClaw browser automation)
browserless_api_token: "2TyGW..."

# Trello API key and token (for OpenClaw task management)
trello_api_key: "your_trello_api_key"
trello_api_token: "your_trello_api_token"

google_api_key: "AIzaSy..."
maton_api_key: "bYGQw4F..."
ha_token: "key..."
ha_url: "http://127.0.0.1:8123"

# xAI API key (for OpenClaw Grok models)
xai_api_key: "xai-..."

# Cloudflare API token
# Required: Zone.DNS:Edit (ACME DNS-01 + DDNS + tunnel hostname CNAMEs)
# For tunnel bootstrap script also: Account.Cloudflare Tunnel:Edit
cloudflare_dns_api_token: "cf-..."

# FileBrowser admin password (plaintext)
filebrowser_password: "your_secure_password"

# Comet (see containers/comet.nix)
# - comet_admin_dashboard_password: required before exposing publicly (for /admin dashboard)
# - torbox_api_key: only if using TorBox scraping/debrid
comet_admin_dashboard_password: "your-strong-admin-password"
torbox_api_key: "tb_..."

clawhub_token: clh_It...

# ZeroEntropy API key (GBrain embeddings — gbrain embed / dream)
zeroentropy_api_key: "ze_..."

# Hermes OpenAI-compatible API server key (shared with Open WebUI).
# Written to /run/hermes.env as API_SERVER_KEY and /run/open-webui.env as OPENAI_API_KEY.
# Generate: openssl rand -hex 32
# Do NOT reuse openrouter_api_key — that is for LLM routing, not the local API bearer.
hermes_api_server_key: "replace-with-openssl-rand-hex-32"

# SSH private key: Hermes → unprivileged agent@nix-pc (Grok Build workstation).
# Generate on the workstation (dotfiles system/agent/keys) and paste full PEM.
nix_pc_agent_ssh_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  ...
  -----END OPENSSH PRIVATE KEY-----
